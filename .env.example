# PySandbox Configuration
PYSANDBOX_MASTER_KEY=change-me-in-production
PYSANDBOX_ENV=dev
PYSANDBOX_VERSION=1.0.0

# Platform database (NOT sandbox data)
DATABASE_URL=sqlite+aiosqlite:///./pysandbox.db

# Docker
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_NETWORK_PREFIX=pysb
CONTAINER_NAME_PREFIX=pysb

# DNS
DNS_BIND_HOST=127.0.0.1
DNS_PORT_RANGE_START=5300
DNS_PORT_RANGE_END=5599
SANDBOX_DNS_DOMAIN=sandbox.local

# Port allocation
HOST_PORT_RANGE_START=20000
HOST_PORT_RANGE_END=29999

# Secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Resource defaults
DEFAULT_SANDBOX_CPU_LIMIT=4.0
DEFAULT_SANDBOX_MEMORY_LIMIT_GB=8.0
DEFAULT_SANDBOX_DISK_LIMIT_GB=50.0
MAX_PLUGINS_PER_SANDBOX=20
PLUGIN_HEALTH_TIMEOUT_SECONDS=120

# Agent
AGENT_IMAGE=pysandbox/pyoz:latest
AGENT_CPU_LIMIT=2.0
AGENT_MEMORY_LIMIT_GB=4.0

# Event bus
EVENT_BUS_BACKEND=asyncio
REDIS_URL=redis://localhost:6379/0

# Observability
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

# Docker Compose platform services
POSTGRES_PASSWORD=pysandbox-dev-password
REDIS_PASSWORD=pysandbox-dev-password
